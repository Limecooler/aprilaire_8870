{
  "config": {
    "flow_title": "Aprilaire 8870 Thermostat",
    "step": {
      "user": {
        "title": "Select Connection Type",
        "description": "Choose how to connect to your Aprilaire 8870 thermostats.",
        "data": {
          "connection_type": "Connection Type"
        }
      },
      "connection_type": {
        "title": "Connection Method",
        "description": "Select how your RS-485 thermostat network is connected to Home Assistant",
        "data": {
          "connection_type": {
            "serial_server": "Network Serial Server (IP address)",
            "serial_port": "Direct Serial Connection (USB/COM port)"
          }
        }
      },
      "serial_server": {
        "title": "Serial Server Configuration",
        "description": "Enter the details for your network-connected serial server.",
        "data": {
          "host": "IP Address or Hostname",
          "port": "Port"
        }
      },
      "serial_port": {
        "title": "Serial Port Configuration",
        "description": "Enter the details for your direct serial connection.",
        "data": {
          "port_name": "Serial Port Name",
          "baud_rate": {
            "9600": "9600 bps",
            "19200": "19200 bps"
          }
        }
      },
      "discovery": {
        "title": "Discovering Thermostats",
        "description": "Searching for Aprilaire 8870 thermostats on the network...",
        "progress": {
          "discovering": "Searching for thermostats..."
        }
      }
    },
    "abort": {
      "already_configured": "This connection is already configured",
      "no_devices_found": "No thermostats found on the network",
      "not_aprilaire_8870": "The device found is not an Aprilaire 8870 thermostat"
    },
    "error": {
      "cannot_connect": "Failed to connect, please verify your connection details",
      "invalid_host": "Invalid IP address or hostname",
      "invalid_port": "Port number must be between 1 and 65535",
      "invalid_serial_port": "Serial port not found or inaccessible",
      "unknown": "Unexpected error occurred"
    },
    "create_entry": {
      "default": "Successfully connected to {thermostats_count} Aprilaire thermostats"
    }
  },
  "entity": {
    "climate": {
      "aprilaire_climate": {
        "state_attributes": {
          "fan_mode": {
            "auto": "Auto",
            "on": "On",
            "circ": "Circulate"
          },
          "hvac_mode": {
            "off": "Off",
            "heat": "Heat",
            "cool": "Cool",
            "auto": "Auto",
            "heat_cool": "Heat/Cool",
            "emht": "Emergency Heat"
          },
          "preset_mode": {
            "none": "None",
            "temp": "Temporary",
            "perm": "Permanent",
            "vac": "Vacation"
          }
        }
      }
    },
    "binary_sensor": {
      "aprilaire_hvac_status": {
        "name": "HVAC Status"
      },
      "aprilaire_fan_status": {
        "name": "Fan Status"
      },
      "aprilaire_filter_status": {
        "name": "Filter Status"
      },
      "aprilaire_error_status": {
        "name": "Error Status"
      },
      "aprilaire_network_override": {
        "name": "Network Override"
      }
    },
    "sensor": {
      "aprilaire_temperature": {
        "name": "Temperature"
      },
      "aprilaire_humidity": {
        "name": "Humidity"
      },
      "aprilaire_outdoor_temperature": {
        "name": "Outdoor Temperature"
      },
      "aprilaire_outdoor_humidity": {
        "name": "Outdoor Humidity"
      }
    },
    "switch": {
      "aprilaire_fan_override": {
        "name": "Fan Override"
      },
      "aprilaire_network_override": {
        "name": "Network Override"
      },
      "aprilaire_backlight": {
        "name": "Backlight"
      }
    }
  },
  "services": {
    "set_text_message": {
      "name": "Set Text Message",
      "description": "Display a message on the thermostat's screen.",
      "fields": {
        "message": {
          "name": "Message",
          "description": "Text message to display (max 31 characters)"
        },
        "message_type": {
          "name": "Message Type",
          "description": "Type of message to set (permanent or temporary)",
          "selector": {
            "select": {
              "options": {
                "pmes1": "Permanent Message 1",
                "pmes2": "Permanent Message 2",
                "pmes3": "Permanent Message 3",
                "pmes4": "Permanent Message 4",
                "tmpmes": "Temporary Message"
              }
            }
          }
        }
      }
    },
    "set_backlight": {
      "name": "Set Backlight",
      "description": "Control the thermostat's backlight.",
      "fields": {
        "level": {
          "name": "Level",
          "description": "Backlight brightness level (0-100)"
        },
        "constant": {
          "name": "Constant On",
          "description": "Keep backlight constantly on"
        }
      }
    },
    "reset_filter": {
      "name": "Reset Filter",
      "description": "Reset the filter alarm status.",
      "fields": {
        "filter_type": {
          "name": "Filter Type",
          "description": "Type of filter to reset",
          "selector": {
            "select": {
              "options": {
                "fltalm": "Air Filter",
                "wpalm": "Water Panel",
                "dehalm": "Dehumidifier",
                "sysalm": "System"
              }
            }
          }
        }
      }
    },
    "set_lockout": {
      "name": "Set Lockout",
      "description": "Configure thermostat lockout features.",
      "fields": {
        "lockout_type": {
          "name": "Lockout Type",
          "description": "Type of lockout to configure",
          "selector": {
            "select": {
              "options": {
                "fanlk": "Fan Lockout",
                "modelk": "Mode Lockout",
                "updnlk": "Setpoint Lockout"
              }
            }
          }
        },
        "lockout_value": {
          "name": "Lockout Value",
          "description": "Lockout setting (0: disabled, 1: time-limited, 2: total lockout)"
        }
      }
    },
    "configure_cos": {
      "name": "Configure COS",
      "description": "Configure Change of State notifications.",
      "fields": {
        "cos_flags": {
          "name": "COS Flags",
          "description": "Change of State flags to enable",
          "selector": {
            "select": {
              "multiple": true,
              "options": {
                "c1": "HVAC Relays",
                "c2": "Temperature/Humidity",
                "c5": "Setpoints",
                "c7": "Mode",
                "c8": "Fan",
                "c14": "Alarms",
                "c19": "Errors"
              }
            }
          }
        }
      }
    }
  }
}

